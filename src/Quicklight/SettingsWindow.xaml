<Window x:Class="Quicklight.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quicklight 설정" Width="680" Height="760" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SolidPanelBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Section">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource HeaderBrush}" />
            <Setter Property="Margin" Value="6,22,0,8" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- A group of settings on one rounded card. -->
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,6" />
        </Style>
        <Style TargetType="DockPanel" x:Key="Line">
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource GlyphBackBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="MultiLine" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="MinHeight" Value="84" />
            <Setter Property="MaxHeight" Value="200" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- On/off switch. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Border x:Name="Track" DockPanel.Dock="Right" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource GlyphBackBrush}">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource TextBrush}" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segment of a segmented choice (theme, backdrop). -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="7" Padding="12,4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Border" x:Key="Segments">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="{DynamicResource GlyphBackBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource GlyphBackBrush}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Remove" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="&#xE711;" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="ToolTip" Value="삭제" />
        </Style>
        <Style TargetType="Button" x:Key="Add" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="Padding" Value="12,5" />
        </Style>

        <!-- keyword → URL, key → text -->
        <DataTemplate x:Key="PairRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding A, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding B, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" />
                <Button Grid.Column="2" Style="{StaticResource Remove}" Click="Remove_Click" Margin="4,0,0,0" />
            </Grid>
        </DataTemplate>

        <!-- name, path, arguments, aliases -->
        <DataTemplate x:Key="CommandRow">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBox Text="{Binding A, UpdateSourceTrigger=PropertyChanged}" ToolTip="이름" Margin="0,0,8,6" />
                <TextBox Grid.Column="1" Text="{Binding B, UpdateSourceTrigger=PropertyChanged}" ToolTip="프로그램, 스크립트 또는 문서 경로" Margin="0,0,0,6" />
                <TextBox Grid.Row="1" Text="{Binding D, UpdateSourceTrigger=PropertyChanged}" ToolTip="다른 이름 (쉼표로 구분)" Margin="0,0,8,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding C, UpdateSourceTrigger=PropertyChanged}" ToolTip="인자" />
                <Button Grid.Column="2" Style="{StaticResource Remove}" Click="Remove_Click" Margin="4,0,0,0" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel>
                <Button Content="설정 파일 열기" Click="OpenFile_Click" Background="Transparent" Padding="0,6"
                        ToolTip="settings.json. 여기 없는 설정도 바꿀 수 있습니다." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="72" />
                    <Button Content="저장" IsDefault="True" Click="Save_Click" MinWidth="72" Background="{DynamicResource AccentBrush}" Foreground="White" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="22,0,22,22">
                <TextBlock Text="일반" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Line}">
                            <TextBox x:Name="HotkeyBox" DockPanel.Dock="Right" Width="170" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     HorizontalContentAlignment="Center" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Cursor="Hand" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="여는 단축키" />
                                <TextBlock Text="칸을 누르고 새 조합을 누르십시오" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Line}">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Segments}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="시스템" />
                                    <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="밝게" />
                                    <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="어둡게" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="테마" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Line}">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Segments}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="BackdropAcrylic" GroupName="Backdrop" Content="흐리게 비침" />
                                    <RadioButton x:Name="BackdropSolid" GroupName="Backdrop" Content="불투명" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="배경" VerticalAlignment="Center" />
                        </DockPanel>
                        <CheckBox x:Name="LaunchAtStartup" Content="Windows 시작 시 실행" />
                        <CheckBox x:Name="AutoUpdate">
                            <StackPanel>
                                <TextBlock Text="자동 업데이트" />
                                <TextBlock Text="검색창이 닫혀 있을 때 새 버전을 설치합니다" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock Text="검색" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="FileSearch">
                            <StackPanel>
                                <TextBlock Text="파일 검색" />
                                <TextBlock Text="Everything으로 파일과 폴더를 찾습니다" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="AdvancedSearch">
                            <StackPanel>
                                <TextBlock Text="상세 설정" />
                                <TextBlock Text="결과 수와 경로 규칙을 직접 정합니다. 끄면 기본값으로 검색하고, 적어 둔 값은 남아 있습니다" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=AdvancedSearch}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        <DockPanel Style="{StaticResource Line}">
                            <TextBox x:Name="MaxResults" DockPanel.Dock="Right" Width="70" HorizontalContentAlignment="Center" />
                            <TextBlock Text="최대 결과 수" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Line}">
                            <TextBox x:Name="MaxFileResults" DockPanel.Dock="Right" Width="70" HorizontalContentAlignment="Center" />
                            <TextBlock Text="최대 파일 수" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Line}">
                            <TextBox x:Name="MaxFolderResults" DockPanel.Dock="Right" Width="70" HorizontalContentAlignment="Center" />
                            <TextBlock Text="최대 폴더 수" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel Margin="0,8">
                            <TextBlock Text="순위를 낮출 경로" />
                            <TextBlock Text="한 줄에 하나. 이 글자를 포함한 경로는 아래로 내립니다" Style="{StaticResource Hint}" Margin="0,2,0,6" />
                            <TextBox x:Name="DemotedPaths" Style="{StaticResource MultiLine}" />
                        </StackPanel>
                        <StackPanel Margin="0,8">
                            <TextBlock Text="숨길 경로" />
                            <TextBlock Text="한 줄에 하나. 이 글자를 포함한 경로는 보이지 않습니다" Style="{StaticResource Hint}" Margin="0,2,0,6" />
                            <TextBox x:Name="ExcludedPaths" Style="{StaticResource MultiLine}" />
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="웹 검색" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Margin="0,8">
                            <TextBlock Text="기본 검색 주소" />
                            <TextBlock Text="{}{0} 자리에 검색어가 들어갑니다" Style="{StaticResource Hint}" Margin="0,2,0,6" />
                            <TextBox x:Name="WebSearchUrl" />
                        </StackPanel>
                        <TextBlock Text="키워드 검색" Margin="0,8,0,0" />
                        <TextBlock Text="키워드와 주소. 'yt 고양이' 처럼 키워드 뒤의 검색어가 {0} 에 들어갑니다" Style="{StaticResource Hint}" Margin="0,2,0,4" />
                        <ItemsControl x:Name="SearchEngines" ItemTemplate="{StaticResource PairRow}" />
                        <Button Content="+ 키워드 추가" Style="{StaticResource Add}" Click="AddEngine_Click" />
                    </StackPanel>
                </Border>

                <TextBlock Text="환전" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="CurrencyConversion" Content="환전 결과 표시" />
                        <DockPanel Style="{StaticResource Line}">
                            <TextBox x:Name="DefaultCurrency" DockPanel.Dock="Right" Width="90" HorizontalContentAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="기본 대상 통화" />
                                <TextBlock Text="auto 는 Windows 지역 설정의 통화. 예: USD, JPY" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="스니펫" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="키를 치고 Enter를 누르면 글을 붙여 넣습니다" Style="{StaticResource Hint}" Margin="0,8,0,4" />
                        <ItemsControl x:Name="Snippets" ItemTemplate="{StaticResource PairRow}" />
                        <Button Content="+ 스니펫 추가" Style="{StaticResource Add}" Click="AddSnippet_Click" />
                    </StackPanel>
                </Border>

                <TextBlock Text="사용자 명령" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="이름 · 경로 / 다른 이름 (쉼표로 구분) · 인자" Style="{StaticResource Hint}" Margin="0,8,0,4" />
                        <ItemsControl x:Name="Commands" ItemTemplate="{StaticResource CommandRow}" />
                        <Button Content="+ 명령 추가" Style="{StaticResource Add}" Click="AddCommand_Click" />
                    </StackPanel>
                </Border>

                <Button Content="기본값으로 되돌리기" Click="Reset_Click" HorizontalAlignment="Left" Margin="0,28,0,0"
                        Background="#D13438" Foreground="White" />
                <TextBlock Text="스니펫과 사용자 명령은 그대로 둡니다. 저장을 눌러야 적용됩니다" Style="{StaticResource Hint}" Margin="2,6,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
