<Window x:Class="Quicklight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Quicklight"
        Title="Quicklight" Width="888" Height="700"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <CollectionViewSource x:Key="GroupedResults">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="GroupedApps">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="12" Background="Transparent" Padding="10,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Both lists: pixel scrolling, and one glass pane under the items that slides to the selected one (MoveGlass). -->
        <ControlTemplate x:Key="GlassList" TargetType="ListBox">
            <ScrollViewer x:Name="Scroll" Focusable="False" CanContentScroll="False"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <Grid x:Name="GlassHost" Margin="{TemplateBinding Padding}">
                    <Canvas IsHitTestVisible="False">
                        <!-- Liquid glass: the (already blurred) backdrop seen magnified through the pane, a thin tint,
                             soft coloured light caught inside the rims, and a bright edge where light hits. -->
                        <Grid x:Name="Glass" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.15" />
                            </Grid.Effect>
                            <Border x:Name="GlassLens" CornerRadius="12" />
                            <Border CornerRadius="12" Background="{DynamicResource GlassFillBrush}" />
                            <Grid x:Name="GlassLight">
                                <Border CornerRadius="12" BorderThickness="7" Margin="-3">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#40C3DAFF" Offset="0" />
                                            <GradientStop Color="#1899C0FF" Offset="0.35" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                            <GradientStop Color="#28E5FDBE" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.Effect>
                                        <BlurEffect Radius="10" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <Border CornerRadius="12" BorderThickness="1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#D0FFFFFF" Offset="0" />
                                        <GradientStop Color="#18FFFFFF" Offset="0.45" />
                                        <GradientStop Color="#18FFFFFF" Offset="0.7" />
                                        <GradientStop Color="#70FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                        </Grid>
                    </Canvas>
                    <ItemsPresenter />
                </Grid>
            </ScrollViewer>
        </ControlTemplate>

        <Style x:Key="TileStyle" TargetType="ListBoxItem" BasedOn="{StaticResource RowStyle}">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="94" />
        </Style>

        <!-- Icon or glyph tile, shared by rows and the app grid. -->
        <DataTemplate x:Key="IconTemplate">
            <Grid>
                <Border CornerRadius="8" Background="{DynamicResource GlyphBackBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ResultTemplate">
            <Grid Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IconTemplate}" Width="30" Height="30" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="14.5" />
                                <Style.Triggers>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Opacity="0.68" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Hint" Text="↵" FontSize="14" Opacity="0" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <!-- Hold Space for a preview. -->
                    <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11" Opacity="0.5"
                               VerticalAlignment="Center" Margin="4,0,2,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Hint" Property="Opacity" Value="0.85" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPreview}" Value="True">
                    <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Direct answers (calculator, currency, translation) as a large card. -->
        <DataTemplate x:Key="HeroTemplate">
            <Grid Margin="4,8,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IconTemplate}" Width="36" Height="36" VerticalAlignment="Top" Margin="0,4,0,0" />
                <StackPanel Grid.Column="1" Margin="16,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="{Binding HeroFontSize}" FontWeight="SemiBold" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="190" LineStackingStrategy="MaxHeight" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Opacity="0.72" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding HeroHint}" FontSize="12" Opacity="0.8" VerticalAlignment="Top" Margin="0,8,4,0" />
            </Grid>
        </DataTemplate>

        <!-- Clipboard entry as a card: the first lines of its text, or the image itself, and when it was copied. -->
        <DataTemplate x:Key="ClipTemplate">
            <StackPanel Margin="6,7,4,6">
                <TextBlock x:Name="Text" Text="{Binding Body}" FontSize="13.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineStackingStrategy="BlockLineHeight" LineHeight="19" MaxHeight="76" />
                <Image x:Name="Picture" Source="{Binding Icon}" Visibility="Collapsed" MaxHeight="120" MaxWidth="360" Stretch="Uniform"
                       HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                <Grid Margin="0,6,0,0">
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Opacity="0.68" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-2,0,0">
                        <TextBlock x:Name="Hint" Text="↵" FontSize="14" Opacity="0" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" Margin="4,0,2,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Body}" Value="{x:Null}">
                    <Setter TargetName="Text" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Picture" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Hint" Property="Opacity" Value="0.85" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:ResultTemplateSelector x:Key="ResultSelector" Row="{StaticResource ResultTemplate}" Hero="{StaticResource HeroTemplate}" Clip="{StaticResource ClipTemplate}" />

        <DataTemplate x:Key="TileTemplate">
            <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IconTemplate}" Width="44" Height="44" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="31" Margin="0,5,0,0" LineStackingStrategy="BlockLineHeight" LineHeight="15" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GroupHeader">
            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource HeaderBrush}" Margin="22,8,0,3" />
        </DataTemplate>

        <!-- Background work (translation install, model download, update download, indexing) as a thin bar. -->
        <DataTemplate x:Key="ActivityTemplate">
            <StackPanel Margin="24,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding RightText}" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0,0,0" />
                </Grid>
                <Grid Height="4" Margin="0,6,0,0" ClipToBounds="True">
                    <Border CornerRadius="2" Background="{DynamicResource SeparatorBrush}" />
                    <Border x:Name="Fill" CornerRadius="2" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Progress}" />
                        </Border.RenderTransform>
                    </Border>
                    <Border x:Name="Runner" Width="140" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentBrush}" Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform X="-140" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsIndeterminate}" Value="True">
                    <Setter TargetName="Fill" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Run">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="Runner" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="-140" To="680" Duration="0:0:1.4">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Run" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Right-click menu, drawn to match the panel. -->
        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="5" Margin="0,0,12,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" Direction="270" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" CornerRadius="8" Padding="10,7" MinWidth="200" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DropShadowEffect x:Key="SurfaceShadow" BlurRadius="30" ShadowDepth="8" Opacity="0.38" Direction="270" />
    </Window.Resources>

    <!-- Two surfaces: the search pill and, below it, a rounded card with the results. Each has its own shadow,
         blurred backdrop, tint and outline. The margin leaves room for the drop shadow. Opacity is animated on show
         and hide; the blur only on the content, so the outlines stay crisp. -->
    <StackPanel x:Name="Shell" Margin="24" VerticalAlignment="Top">
        <Grid Height="62" Width="720">
            <Border CornerRadius="31" Background="{DynamicResource SolidPanelBrush}" Effect="{StaticResource SurfaceShadow}" />
            <Grid x:Name="BarPanel">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,720,62" RadiusX="31" RadiusY="31" />
                </Grid.Clip>
                <!-- A blurred snapshot of the screen behind the window: acrylic that works with any corner radius.
                     Blurred once when captured (no live effect, so animation frames stay cheap), drawn scaled up.
                     On a Canvas so the (larger) snapshot never takes part in sizing the panel. -->
                <Canvas IsHitTestVisible="False">
                    <Image x:Name="Backdrop" Stretch="None" RenderOptions.BitmapScalingMode="Linear" />
                </Canvas>
                <Border x:Name="Tint" Background="{DynamicResource PanelBrush}" />
                <Grid x:Name="Bar" Margin="24,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="20" Opacity="0.7"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="1" x:Name="Placeholder" Text="Quicklight 검색" FontSize="22" IsHitTestVisible="False"
                               Foreground="{DynamicResource PlaceholderBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                    <TextBox Grid.Column="1" x:Name="Query" FontSize="22" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="Transparent"
                             SelectionBrush="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                             TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown" PreviewKeyUp="Query_PreviewKeyUp"
                             InputMethod.PreferredImeState="DoNotCare" />
                    <Canvas Grid.Column="1" x:Name="CaretLayer" IsHitTestVisible="False">
                        <Rectangle x:Name="Caret" Width="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextBrush}" Visibility="Collapsed">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="CaretMove" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                    <TextBlock Grid.Column="2" x:Name="Status" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>

            </Grid>
            <Border CornerRadius="31" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" IsHitTestVisible="False" />
        </Grid>

        <!-- The results card. Its height animates towards the content's; at zero it fades out. On the app screen it widens. -->
        <Grid x:Name="ListSurface" Margin="0,10,0,0" Width="720" Height="0" Opacity="0" HorizontalAlignment="Center" SizeChanged="ListSurface_SizeChanged">
            <Border CornerRadius="31" Background="{DynamicResource SolidPanelBrush}" Effect="{StaticResource SurfaceShadow}" />
            <Grid x:Name="ListPanel" SizeChanged="ListPanel_SizeChanged">
                <Canvas IsHitTestVisible="False">
                    <Image x:Name="ListBackdrop" Stretch="None" RenderOptions.BitmapScalingMode="Linear" />
                </Canvas>
                <Border x:Name="ListTint" Background="{DynamicResource PanelBrush}" />
                <!-- On a Canvas so the content keeps its natural height while the card's height animates towards it. -->
                <Canvas>
                    <StackPanel x:Name="Body" Width="{Binding ActualWidth, ElementName=ListPanel}" SizeChanged="Body_SizeChanged">
                <!-- Background work as thin bars, right under the search pill. -->
                <Border x:Name="ActivityPanel" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorBrush}" Padding="0,5,0,3"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <ItemsControl x:Name="Activities" ItemTemplate="{StaticResource ActivityTemplate}" Focusable="False" />
                </Border>
                <ListBox x:Name="Results" ItemsSource="{Binding Source={StaticResource GroupedResults}}"
                         ItemTemplateSelector="{StaticResource ResultSelector}" ItemContainerStyle="{StaticResource RowStyle}"
                         Template="{StaticResource GlassList}" Background="Transparent" BorderThickness="0" Padding="0,4,0,6" MaxHeight="500" Visibility="Collapsed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         VirtualizingPanel.IsVirtualizing="False" Focusable="False" KeyboardNavigation.TabNavigation="None"
                         PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseWheel="List_PreviewMouseWheel" PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp">
                    <ListBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
                    </ListBox.GroupStyle>
                </ListBox>

                <!-- Preview of the selected file or folder (hold Space). Replaces the result list while open. -->
                <Grid x:Name="PreviewPanel" Height="440" Margin="20,10,20,10" Visibility="Collapsed" RenderTransformOrigin="0.5,0" PreviewMouseWheel="PreviewPanel_PreviewMouseWheel">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="PreviewScale" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="4,0,4,8">
                        <TextBlock x:Name="PreviewTitle" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PreviewInfo" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource GlyphBackBrush}" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="12" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBox x:Name="PreviewText" IsReadOnly="True" Focusable="False" BorderThickness="0" Background="Transparent" Padding="12,10"
                                     Foreground="{DynamicResource TextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                            <!-- An app's preview: its parts as rows (shortcuts, program, tools, installer, uninstaller); Enter runs one. -->
                            <ListBox x:Name="PreviewParts" ItemTemplate="{StaticResource ResultTemplate}" ItemContainerStyle="{StaticResource RowStyle}"
                                     Template="{StaticResource GlassList}" Background="Transparent" BorderThickness="0" Padding="0,6" Visibility="Collapsed"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                     VirtualizingPanel.IsVirtualizing="False" Focusable="False" KeyboardNavigation.TabNavigation="None"
                                     PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Every installed app, sorted and sectioned by initial ("앱", "app", "프로그램", ...). -->
                <ListBox x:Name="AppGrid" ItemsSource="{Binding Source={StaticResource GroupedApps}}"
                         ItemTemplate="{StaticResource TileTemplate}" ItemContainerStyle="{StaticResource TileStyle}"
                         Template="{StaticResource GlassList}" Background="Transparent" BorderThickness="0" Padding="0,4,0,8" Height="540" Visibility="Collapsed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         VirtualizingPanel.IsVirtualizing="False" Focusable="False" KeyboardNavigation.TabNavigation="None"
                         PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Width="800" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
                    </ListBox.GroupStyle>
                </ListBox>

                <Border x:Name="Footer" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SeparatorBrush}" Padding="24,8" Visibility="Collapsed">
                    <TextBlock x:Name="FooterText" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                </Border>

                    </StackPanel>
                </Canvas>
            </Grid>
            <Border CornerRadius="31" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" IsHitTestVisible="False" />
        </Grid>
    </StackPanel>
</Window>
