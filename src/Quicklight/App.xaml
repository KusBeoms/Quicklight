<Application x:Class="Quicklight.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Siri/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <!-- The Jamsil: the one typeface of every window. Each weight is a family of its own, so bold text names the Bold file. -->
            <FontFamily x:Key="UiFont">./Assets/Fonts/#The Jamsil 3 Regular, Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
            <FontFamily x:Key="UiFontBold">./Assets/Fonts/#The Jamsil 5 Bold, Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
