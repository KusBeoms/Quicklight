<Application x:Class="Quicklight.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Siri/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="UiFont">./Assets/Fonts/#Pretendard Std, Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
