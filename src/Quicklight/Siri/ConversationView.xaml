<UserControl x:Class="Quicklight.Siri.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The conversation and its input bar, shared by the floating answer panel and the app window. The brushes
         (TextBrush, GlyphBackBrush, ...) come from whichever window hosts it: dark ink in the panel, the system theme in the app. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      ScrollChanged="Scroll_ScrollChanged">
            <StackPanel Margin="20,16,20,16">
                <StackPanel x:Name="Messages" SizeChanged="Messages_SizeChanged" />
                <StackPanel x:Name="Activity" />
            </StackPanel>
        </ScrollViewer>

        <WrapPanel x:Name="Chips" Grid.Row="1" Margin="20,0,20,8" Visibility="Collapsed" />

        <Grid Grid.Row="2" Margin="16,6,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AddButton" Style="{StaticResource SiriCircleButton}" Width="38" Height="38" FontSize="16" Content="&#xE710;" ToolTip="추가" Click="Add_Click" VerticalAlignment="Bottom">
                <Button.ContextMenu>
                    <ContextMenu x:Name="AddMenu">
                        <MenuItem Header="사진" Click="AddPhoto_Click" />
                        <MenuItem Header="파일" Click="AddFile_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Border Grid.Column="1" Margin="10,0" CornerRadius="19" MinHeight="38" Background="{DynamicResource GlyphBackBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBlock x:Name="Placeholder" Text="Qutra에게 물어보기" FontSize="15.5" Margin="18,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource PlaceholderBrush}" />
                    <TextBox x:Name="Input" AutomationProperties.Name="Qutra에게 물어보기" FontSize="15.5" BorderThickness="0" Background="Transparent" Padding="18,8" MaxHeight="130"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}" VerticalContentAlignment="Center"
                             PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged" />
                </Grid>
            </Border>
            <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource SiriCircleButton}" Width="38" Height="38" FontSize="16" Content="&#xE720;" ToolTip="말하기"
                    Background="{DynamicResource AccentBrush}" Foreground="White" Click="Send_Click" VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</UserControl>
