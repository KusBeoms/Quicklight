<Window x:Class="Quicklight.Siri.SiriAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:siri="clr-namespace:Quicklight.Siri"
        Title="Qutra Beta" Width="960" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SolidPanelBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- The history and the conversation: history on the left (a grid of cards or a list), the chosen conversation on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="296" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SeparatorBrush}" Background="{DynamicResource HoverBrush}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,12,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OptionsButton" Style="{StaticResource SiriCircleButton}" Content="&#xE712;" ToolTip="옵션" Click="Options_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="OptionsMenu">
                                <MenuItem x:Name="GridItem" Header="격자" IsCheckable="True" Click="View_Click" />
                                <MenuItem x:Name="ListItem" Header="목록" IsCheckable="True" Click="View_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource SiriCircleButton}" Content="&#xE721;" ToolTip="검색" Margin="8,0,0,0" Click="Search_Click" />
                    <Button Grid.Column="3" Style="{StaticResource SiriCircleButton}" Content="&#xE70F;" ToolTip="새로운 대화" Click="New_Click" />
                </Grid>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="14,0,14,8" Visibility="Collapsed" Padding="10,6" BorderThickness="0"
                         Background="{DynamicResource GlyphBackBrush}" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         TextChanged="SearchBox_TextChanged" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <WrapPanel x:Name="History" Margin="10,2,10,12" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorBrush}">
                <TextBlock x:Name="TitleText" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource UiFontBold}" FontSize="14"
                           TextTrimming="CharacterEllipsis" MaxWidth="480" Margin="16,0" />
            </Border>
            <siri:ConversationView x:Name="Chat" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
